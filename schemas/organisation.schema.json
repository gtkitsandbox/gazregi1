{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gazetteregistry.com/schemas/organisation.schema.json",
  "additionalProperties": false,
  "properties": {
    "organisation_id": {
      "pattern": "^org:[a-z]{2}:[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Organisation Id",
      "type": "string"
    },
    "country_code": {
      "pattern": "^[A-Z]{2}$",
      "title": "Country Code",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "type": {
      "enum": [
        "government_body",
        "company",
        "professional_body",
        "statutory_body",
        "other"
      ],
      "title": "Type",
      "type": "string"
    },
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "identity_status": {
      "default": "unverified",
      "enum": [
        "operator_verified",
        "unverified"
      ],
      "title": "Identity Status",
      "type": "string"
    },
    "verified_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified At"
    },
    "basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Basis"
    }
  },
  "required": [
    "organisation_id",
    "country_code",
    "name",
    "type"
  ],
  "title": "OrganisationEntity",
  "type": "object"
}
